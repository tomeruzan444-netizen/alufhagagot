Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^%D7%90%D7%99%D7%98%D7%95%D7%9D-%D7%92%D7%92%D7%95%D7%AA-%D7%91%D7%92%D7%9F-%D7%99%D7%91%D7%A0%D7%94-%D7%9E%D7%99%D7%93%D7%A2-%D7%A8%D7%9C%D7%95%D7%95%D7%A0%D7%98%D7%99-%D7%95%D7%9E%D7%97%D7%99%D7%A8/?$ /%D7%90%D7%99%D7%98%D7%95%D7%9D-%D7%92%D7%92%D7%95%D7%AA-%D7%91%D7%92%D7%9F-%D7%99%D7%91%D7%A0%D7%94/ [R=301,L]
  RewriteRule ^%D7%97%D7%95%D7%9E%D7%A8%D7%99-%D7%90%D7%99%D7%98%D7%95%D7%9D-%D7%A9%D7%95%D7%A0%D7%99%D7%9D-%D7%90%D7%96-%D7%90%D7%99%D7%9C%D7%95-%D7%97%D7%95%D7%9E%D7%A8%D7%99%D7%9D-%D7%A7%D7%99%D7%99%D7%9E%D7%99/?$ /%D7%97%D7%95%D7%9E%D7%A8%D7%99-%D7%90%D7%99%D7%98%D7%95%D7%9D/ [R=301,L]
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>
